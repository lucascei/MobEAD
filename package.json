{
  "name": "mobead",
  "version": "1.0.0",
  "description": "MobEAD - Pipeline CI/CD - Lucas Alves",
  "private": true,
  "scripts": {
    "build": "node scripts/build.js",
    "test": "mocha tests/**/*.test.js --reporter mocha-junit-reporter --reporter-options mochaFile=test-results.xml --reporter spec",
    "test:coverage": "nyc --reporter=lcov --reporter=text npm run test"
  },
  "devDependencies": {
    "chai": "^4.4.1",
    "mocha": "^10.7.3",
    "mocha-junit-reporter": "^2.2.1",
    "nyc": "^15.1.0"
  },
  "nyc": {
    "include": ["lib/**/*.js"],
    "reporter": ["lcov", "text"],
    "all": true
  }
}
